{
  "name": "@w3booster/master",
  "version": "2.0.0",
  "description": "W3Booster Master",
  "license": "Patrick Schäfer",
  "engines": {
    "node": ">= 8.0.0"
  },
  "scripts": {
    "x": "tsc -v",
    "dev": "pnpm run build && pnpm run watch-local",
    "start": "nodemon -w src src/app/server.ts",
    "start-with-prod-db": "cross-env config=devProdDb nodemon -w src src/app/server.ts",
    "start-old": "pnpm run debug-local",
    "build": "pnpm run build-ts && pnpm run copy-static-assets",
    "prod-serve": "cross-env config=prod node dist/app/server.js",
    "prod-pro-serve": "node -r dotenv/config dist/app/server.js dotenv_config_path=dist/environments/prod-pro.env",
    "watch-node": "nodemon dist/app/server.js",
    "watch": "concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"yellow.bold,cyan.bold,green.bold\"  \"pnpm run watch-ts\" \"pnpm run watch-node\"",
    "watch-local": "concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"yellow.bold,cyan.bold,green.bold\" \"pnpm run watch-ts\" \"pnpm run serve-debug-local\"",
    "watch-test": "pnpm run test -- --watchAll",
    "build-ts": "tsc",
    "watch-ts": "tsc -w",
    "tslint": "tslint -c tslint.json -p tsconfig.json",
    "lint": "pnpm run tslint",
    "copy-static-assets": "ts-node tools/copyStaticAssets.ts",
    "debug": "pnpm run build && pnpm run watch-debug-local",
    "debug-local": "pnpm run build && pnpm run watch-debug-local",
    "debug-localdb": "pnpm run build && pnpm run watch-debug-localdb",
    "dashboard": "parse-dashboard --appId ${PARSE_APP_ID:-PSBdEx46ycVok7grEcdOMKPMsLYUl1OZ} --masterKey ${PARSE_MASTER_KEY:-local-master-key-change-me} --serverURL=\"https://localhost:25080/parse\" --appName W3Booster-Local ",
    "prod-dashboard": "parse-dashboard --appId ${PARSE_APP_ID:-PSBdEx46ycVok7grEcdOMKPMsLYUl1OZ} --masterKey ${PARSE_MASTER_KEY:?Set PARSE_MASTER_KEY} --serverURL=\"https://app.w3booster.com/parse\" --appName W3Booster-Local ",
    "serve-debug-localdb": "nodemon -r dotenv/config dist/app/server.js dotenv_config_path=dist/environments/localhost_db.env",
    "serve-debug-local": "nodemon --inspect -r dotenv/config dist/app/server.js dotenv_config_path=dist/environments/localhost.env",
    "serve-prod": "node -r dotenv/config dist/app/server.js dotenv_config_path=dist/environments/production.env",
    "watch-debug-localdb": "concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"yellow.bold,cyan.bold,green.bold\" \"pnpm run watch-ts\" \"pnpm run serve-debug-localdb\" \"pnpm run dashboard\"",
    "watch-debug-local": "concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"yellow.bold,cyan.bold,green.bold\" \"pnpm run watch-ts\" \"pnpm run serve-debug-local\" \"pnpm run dashboard\""
  },
  "dependencies": {
    "@types/parse": "^3.0.9",
    "@w3booster/datamodel": "workspace:*",
    "body-parser": "^1.20.5",
    "chokidar": "^4.0.1",
    "cors": "^2.8.6",
    "deep-diff": "^1.0.2",
    "discord-oauth2": "^2.12.1",
    "discord.js": "^14.16.3",
    "errorhandler": "^1.5.1",
    "express": "^4.22.1",
    "folder-hash": "^4.0.4",
    "module-alias": "^2.2.3",
    "node-rsa": "^1.1.1",
    "node-schedule": "^2.1.1",
    "parse": "^5.3.0",
    "parse-server": "^7.3.0",
    "paypal-rest-sdk": "^1.8.1",
    "rxjs": "^7.8.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/module-alias": "^2.0.4",
    "@types/shelljs": "^0.8.15",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "nodemon": "^3.1.14",
    "parse-dashboard": "^9.1.1",
    "shelljs": "^0.9.2",
    "ts-node": "~10.9.2",
    "tslint": "~6.1.3",
    "typescript": "^5.4.5"
  }
}
