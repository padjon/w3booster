{
  "name": "@w3booster/overlay",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --port 8080",
    "start": "ng serve --port 8080",
    "start-ssl": "ng serve --port 8080 --ssl --ssl-key cert\\server.key --ssl-cert cert\\server.crt",
    "build": "ng build --configuration production",
    "update": "ng update",
    "preinstall": "set ELECTRON_SKIP_BINARY_DOWNLOAD=1",
    "test": "ng test",
    "lint": "echo \"Angular lint is deferred until TSLint/codelyzer is replaced with ESLint\"",
    "e2e": "ng e2e"
  },
  "browser": {
    "fs": false,
    "http": false,
    "os": false,
    "ffi": false,
    "net": false,
    "path": false,
    "ref": false,
    "__process": false,
    "process": false,
    "ref-struct": false,
    "child_process": false,
    "electron": false,
    "@electron/remote": false
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.13",
    "@angular/common": "^18.2.13",
    "@angular/compiler": "^18.2.13",
    "@angular/core": "^18.2.13",
    "@angular/forms": "^18.2.13",
    "@angular/platform-browser": "^18.2.13",
    "@angular/platform-browser-dynamic": "^18.2.13",
    "@angular/router": "^18.2.13",
    "@babel/runtime-corejs3": "^7.29.2",
    "@electron/remote": "github:electron/remote",
    "@w3booster/datamodel": "workspace:*",
    "core-js-pure": "^3.49.0",
    "crypto-js": "^4.2.0",
    "deep-diff": "^1.0.2",
    "electron": "^15.5.7",
    "events": "^3.1.0",
    "idb-keyval": "^6.2.2",
    "parse": "^5.3.0",
    "reconnecting-websocket": "^4.2.0",
    "ref": "^1.3.5",
    "ref-struct": "^1.1.0",
    "rxjs": "~6.6.7",
    "rxjs-compat": "^6.5.3",
    "tslib": "^2.8.1",
    "uuid": "^14.0.0",
    "ws": "^8.20.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.12",
    "@angular/cli": "^18.2.12",
    "@angular/compiler-cli": "^18.2.13",
    "@angular/language-service": "^18.2.13",
    "@types/electron": "^1.6.12",
    "@types/ffi": "^0.2.3",
    "@types/jasmine": "~3.3.8",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^18.19.130",
    "@types/parse": "^3.0.9",
    "@types/ref": "0.0.28",
    "@types/ref-struct": "0.0.29",
    "@types/ws": "^8.18.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~2.2.0",
    "karma-coverage-istanbul-reporter": "~2.0.1",
    "karma-jasmine": "~2.0.1",
    "karma-jasmine-html-reporter": "^1.4.0",
    "protractor": "~7.0.0",
    "ts-node": "~7.0.0",
    "tslint": "~6.1.3",
    "typescript": "~5.4.5"
  }
}
