{
  "name": "@w3booster/client",
  "version": "1.2.0",
  "description": "W3Booster Client",
  "scripts": {
    "ng": "set NODE_OPTIONS=--openssl-legacy-provider && ng",
    "dev": "NODE_OPTIONS=--openssl-legacy-provider ng serve --configuration=local --host 0.0.0.0",
    "start": "set NODE_OPTIONS=--openssl-legacy-provider && ng serve --configuration=local --o --host 0.0.0.0",
    "start:dev": "set NODE_OPTIONS=--openssl-legacy-provider && ng serve --configuration=development --o --host 0.0.0.0",
    "start:prod": "set NODE_OPTIONS=--openssl-legacy-provider && ng serve --configuration=production --o --host 0.0.0.0",
    "build:local": "ng build --configuration=local",
    "build:dev": "ng build --configuration=development",
    "build:prod": "ng build --configuration production",
    "build": "pnpm run build:prod",
    "pwa:build:local": "ng build --configuration=local && sw-precache --root=dist --config=precache-config.js",
    "pwa:build:dev": "ng build --configuration production --configuration=development && sw-precache --root=dist --config=precache-config.js",
    "pwa:build:prod": "ng build --configuration production && sw-precache --root=dist --config=precache-config.js",
    "test": "ng test",
    "e2e:install": "playwright install chromium",
    "e2e:pw": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "PWDEBUG=1 playwright test --headed",
    "e2e": "ng e2e",
    "generate": "ng generate",
    "compodoc:gen": "./node_modules/.bin/compodoc -p src/tsconfig.app.json",
    "compodoc:serve": "./node_modules/.bin/compodoc -s src/tsconfig.app.json",
    "compodoc": "pnpm run compodoc:gen && pnpm run compodoc:serve",
    "xprecommit": "lint-staged",
    "lint": "echo \"Angular lint is deferred until TSLint/codelyzer is replaced with ESLint\"",
    "format:fix": "pretty-quick --staged",
    "preinstall": "set ELECTRON_SKIP_BINARY_DOWNLOAD=1"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "pretty-quick --staged",
      "tslint --fix --config tslint.json --project tsconfig.json",
      "git add"
    ]
  },
  "browser": {
    "fs": false,
    "http": false,
    "os": false,
    "ffi": false,
    "net": false,
    "path": false,
    "crypto": false,
    "ref": false,
    "ref-struct": false,
    "child_process": false,
    "@electron/remote": false
  },
  "author": "Patrick Schäfer",
  "license": "Patrick Schäfer",
  "dependencies": {
    "@angular/animations": "^18.2.13",
    "@angular/common": "^18.2.13",
    "@angular/compiler": "^18.2.13",
    "@angular/core": "^18.2.13",
    "@angular/forms": "^18.2.13",
    "@angular/localize": "^18.2.13",
    "@angular/platform-browser": "^18.2.13",
    "@angular/platform-browser-dynamic": "^18.2.13",
    "@angular/router": "^18.2.13",
    "@angular/service-worker": "^18.2.13",
    "@babel/runtime-corejs3": "^7.29.2",
    "@ng-bootstrap/ng-bootstrap": "^17.0.1",
    "@ng-select/ng-select": "^13.9.1",
    "@nth-cloud/ng-toggle": "^11.0.0",
    "@popperjs/core": "^2.11.8",
    "@w3booster/datamodel": "workspace:*",
    "bootstrap": "^4.6.2",
    "core-js-pure": "^3.49.0",
    "crypto-js": "^4.2.0",
    "deep-diff": "^1.0.2",
    "events": "^3.3.0",
    "idb-keyval": "^6.2.2",
    "jwt-decode": "^4.0.0",
    "ngx-toastr": "^19.0.0",
    "parse": "^5.3.0",
    "reconnecting-websocket": "^4.4.0",
    "rxjs": "^6.5.4",
    "rxjs-compat": "^6.5.4",
    "tslib": "^2.0.0",
    "uuid": "^14.0.0",
    "ws": "^8.20.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.19",
    "@angular/cli": "^18.2.19",
    "@angular/compiler-cli": "^18.2.13",
    "@angular/language-service": "^18.2.13",
    "@electron/remote": "^2.0.1",
    "@playwright/test": "^1.59.1",
    "@types/electron": "^1.6.10",
    "@types/ffi": "^0.2.2",
    "@types/node": "^18.19.130",
    "@types/parse": "^3.0.9",
    "@types/ref": "0.0.28",
    "@types/ref-struct": "0.0.29",
    "@types/ws": "^8.18.1",
    "electron": "^15.0.0",
    "tslint": "~6.1.3",
    "typescript": "^5.4.5"
  }
}
